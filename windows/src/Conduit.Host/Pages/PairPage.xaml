<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Conduit.Host"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="1040">
            <TextBlock Text="配对手机" Style="{StaticResource PageTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                       Text="在 iPhone 上打开 Conduit，点“配对电脑”扫描此二维码。每个二维码只能用一次，30 分钟后失效。" />

            <Grid Margin="0,24,0,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20" Background="#FAF9F5">
                    <Image x:Name="QrImage" Width="300" Height="300" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="二维码" Style="{StaticResource Eyebrow}" Margin="0" />
                    <TextBlock x:Name="ExpiryText" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重新生成" Click="NewCode_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="复制配对链接" Click="Copy_Click" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource ConduitInkSoftBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="手机无法使用相机（例如在 LiveContainer 中）？复制链接发送到手机，在 App 中粘贴即可。" />

                    <TextBlock Text="手机会尝试的地址" Style="{StaticResource Eyebrow}" />
                    <ItemsControl x:Name="EndpointList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndpointItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                    <TextBlock Text="{x:Bind Kind}" Width="80" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Url}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar x:Name="AnywhereHint" IsOpen="False" IsClosable="False" Severity="Warning"
                             Title="目前只能在局域网内连接"
                             Message="要在外网使用，请在“连接方式”中开启 Cloudflare Tunnel 或 DDNS，或在电脑和 iPhone 上安装 Tailscale。" />
                </StackPanel>
            </Grid>

            <TextBlock Text="已配对的手机" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="NoDevices" Text="暂无。" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{x:Bind DotBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="移除" Tag="{x:Bind Id}" Click="Remove_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
