<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Conduit.Host"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="1040">
            <TextBlock Text="Pair a phone" Style="{StaticResource PageTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                       Text="Open Conduit on your iPhone, tap “Pair with a computer” and scan this code. Each code works once and expires after 30 minutes." />

            <Grid Margin="0,24,0,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20" Background="#FAF9F5">
                    <Image x:Name="QrImage" Width="300" Height="300" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="CODE" Style="{StaticResource Eyebrow}" Margin="0" />
                    <TextBlock x:Name="ExpiryText" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="New code" Click="NewCode_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Copy pairing link" Click="Copy_Click" />
                    </StackPanel>
                    <TextBlock Foreground="{ThemeResource ConduitInkSoftBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="No camera (e.g. in LiveContainer)? Copy the link, send it to your phone and paste it in the app." />

                    <TextBlock Text="THE PHONE WILL TRY" Style="{StaticResource Eyebrow}" />
                    <ItemsControl x:Name="EndpointList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:EndpointItem">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2">
                                    <TextBlock Text="{x:Bind Kind}" Width="80" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Url}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <InfoBar x:Name="AnywhereHint" IsOpen="False" IsClosable="False" Severity="Warning"
                             Title="Only reachable on this network"
                             Message="To connect from anywhere, install Tailscale on this PC and the iPhone, or set a relay URL in Settings." />
                </StackPanel>
            </Grid>

            <TextBlock Text="PAIRED PHONES" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="NoDevices" Text="None yet." Foreground="{ThemeResource ConduitInkSoftBrush}" />
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{x:Bind DotBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Remove" Tag="{x:Bind Id}" Click="Remove_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
