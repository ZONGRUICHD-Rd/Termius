<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="820" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Text="连接方式" Style="{StaticResource PageTitle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                       Text="选择手机可以通过哪些方式连到这台电脑。可同时开启多种，手机会自动选最快的一条（也可以在手机上手动指定）。所有方式都端到端加密。手机上也能修改这里的设置。" />

            <TextBlock Text="内网直连" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="LanToggle" Header="允许局域网 / Tailscale 直连（最快）" />
                    <TextBlock x:Name="LanAddresses" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="CLOUDFLARE TUNNEL（外网）" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="CfToggle" Header="通过 Cloudflare Tunnel 从外网访问" />
                    <RadioButtons x:Name="CfMode" Header="类型" SelectionChanged="CfMode_Changed">
                        <x:String>快速隧道：免费、无需账号，每次启动地址会变</x:String>
                        <x:String>自有域名：使用 Cloudflare 账号里的隧道令牌，地址固定（推荐）</x:String>
                    </RadioButtons>
                    <StackPanel x:Name="CfTokenPanel" Spacing="10">
                        <PasswordBox x:Name="CfToken" Header="隧道令牌（Tunnel Token）" />
                        <TextBox x:Name="CfHostname" Header="公共主机名" PlaceholderText="conduit.example.com" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}"
                                   Text="在 Cloudflare Zero Trust → Networks → Tunnels 新建隧道，复制令牌；并为它添加一个公共主机名，服务填写 http://localhost:47821（端口与“设置”中的直连端口一致）。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="CfDot" Width="9" Height="9" Fill="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="CfStatus" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="CfUrl" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}"
                               Text="首次开启时会自动从 Cloudflare 官方 GitHub 下载 cloudflared（约 30 MB）。" />
                </StackPanel>
            </Border>

            <TextBlock Text="DDNS / 端口映射（外网）" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="DdnsToggle" Header="通过域名和端口从外网访问" />
                    <TextBox x:Name="DdnsDomain" Header="域名" PlaceholderText="home.example.com" />
                    <NumberBox x:Name="DdnsPort" Header="外网端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                    <CheckBox x:Name="DdnsTls" Content="使用 TLS（wss://，前面有 HTTPS 反向代理时勾选）" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}"
                               Text="需要在路由器上把外网端口转发到这台电脑的直连端口，并让域名解析到你的公网 IP（DDNS）。" />
                </StackPanel>
            </Border>

            <TextBlock Text="中继服务器（可选）" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBox x:Name="RelayBox" Header="中继地址" PlaceholderText="wss://relay.example.com" />
                    <TextBox x:Name="ExtraBox" Header="其他要告诉手机的地址（每行一个）" PlaceholderText="ws://my-pc.tailnet.ts.net:47821" AcceptsReturn="True" Height="72" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                <Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
