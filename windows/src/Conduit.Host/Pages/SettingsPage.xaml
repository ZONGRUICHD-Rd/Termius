<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="820" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />

            <TextBlock Text="这台电脑" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBox x:Name="HostNameBox" Header="在手机上显示的名称" />
                    <NumberBox x:Name="PortBox" Header="直连端口" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" />
                    <ToggleSwitch x:Name="StartupToggle" Header="登录 Windows 时自动启动" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="允许通过 Windows 防火墙…" Click="Firewall_Click" />
                        <Button Content="打开数据文件夹" Click="OpenData_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="IPHONE 灵动岛后台推送（可选）" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                               Text="让 Conduit 在后台时灵动岛也能继续更新。需要 Apple 开发者账号的 APNs 密钥（.p8），并用你的团队证书签名 App。LiveContainer 中不可用。" />
                    <ToggleSwitch x:Name="ApnsToggle" Header="通过 APNs 推送实时活动更新" />
                    <TextBox x:Name="TeamBox" Header="Team ID" />
                    <TextBox x:Name="KeyIdBox" Header="Key ID" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="载入 .p8 密钥…" Click="LoadKey_Click" />
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                <Button Content="保存" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
