<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="820" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <TextBlock Text="THIS COMPUTER" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBox x:Name="HostNameBox" Header="Name shown on the phone" />
                    <NumberBox x:Name="PortBox" Header="Direct port (LAN / Tailscale)" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" />
                    <ToggleSwitch x:Name="StartupToggle" Header="Start Conduit Host when I sign in" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Allow through Windows Firewall…" Click="Firewall_Click" />
                        <Button Content="Open data folder" Click="OpenData_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="CONNECT FROM ANYWHERE" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                               Text="Fastest: install Tailscale on this PC and your iPhone — Conduit finds it automatically and connects peer-to-peer. Or run the tiny Conduit relay on any server (see relay/README) and enter it here; it only forwards end-to-end encrypted bytes." />
                    <TextBox x:Name="RelayBox" Header="Relay URL" PlaceholderText="wss://relay.example.com" />
                    <TextBox x:Name="ExtraBox" Header="Extra addresses to advertise (one per line)" PlaceholderText="ws://my-pc.tailnet.ts.net:47821" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="IPHONE LIVE ACTIVITY PUSH (OPTIONAL)" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                               Text="Keeps the Dynamic Island updating while the Conduit app is in the background. Needs an APNs auth key (.p8) from your Apple Developer account and a build signed with your team. Not available in LiveContainer." />
                    <ToggleSwitch x:Name="ApnsToggle" Header="Send Live Activity updates via APNs" />
                    <TextBox x:Name="TeamBox" Header="Team ID" />
                    <TextBox x:Name="KeyIdBox" Header="Key ID" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Load .p8 key…" Click="LoadKey_Click" />
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
