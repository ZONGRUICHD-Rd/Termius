<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Conduit.Host"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock x:Name="Headline" Text="Conduit Host" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="Subhead" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                       Text="让 iPhone 随时随地使用这台电脑上的编程 Agent。" />

            <Grid Margin="0,24,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Grid.Column="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="内网直连" Style="{StaticResource Eyebrow}" Margin="0" />
                        <TextBlock x:Name="DirectValue" Text="…" FontSize="22" FontFamily="{StaticResource ConduitSerif}" />
                        <TextBlock x:Name="DirectDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="外网访问" Style="{StaticResource Eyebrow}" Margin="0" />
                        <TextBlock x:Name="RelayValue" Text="…" FontSize="22" FontFamily="{StaticResource ConduitSerif}" />
                        <TextBlock x:Name="RelayDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="手机" Style="{StaticResource Eyebrow}" Margin="0" />
                        <TextBlock x:Name="PhonesValue" Text="0" FontSize="22" FontFamily="{StaticResource ConduitSerif}" />
                        <TextBlock x:Name="PhonesDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Column="3">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AGENT" Style="{StaticResource Eyebrow}" Margin="0" />
                        <TextBlock x:Name="AgentsValue" Text="0" FontSize="22" FontFamily="{StaticResource ConduitSerif}" />
                        <TextBlock x:Name="AgentsDetail" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar x:Name="SetupHint" Margin="0,16,0,0" IsOpen="False" IsClosable="False" Severity="Informational"
                     Title="还没有配对手机" Message="打开“配对手机”，用 iPhone 上的 Conduit 扫描二维码。">
                <InfoBar.ActionButton>
                    <Button Content="配对手机" Click="Pair_Click" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="正在工作" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="NoActive" Text="没有正在运行的 Agent。可以在 iPhone 上开始新对话。" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            <ItemsControl x:Name="ActiveList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:SessionItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{x:Bind StateBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                    <TextBlock Text="{x:Bind StateLabel}" Foreground="{x:Bind StateBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}" HorizontalAlignment="Right">
                                        <Run Text="{x:Bind AgentName}" /><Run Text=" · " /><Run Text="{x:Bind Folder}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="已连接的手机" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="NoPhones" Text="当前没有手机连接。" Foreground="{ThemeResource ConduitInkSoftBrush}" />
            <ItemsControl x:Name="PhonesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PhoneItem">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                            <FontIcon Glyph="&#xE8EA;" FontSize="14" />
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Route}" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                            <TextBlock Text="{x:Bind Since}" Foreground="{ThemeResource ConduitInkSoftBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="运行日志" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}" Padding="14">
                <ScrollViewer x:Name="LogScroll" MaxHeight="240">
                    <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
