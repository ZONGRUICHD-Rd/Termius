<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Conduit.Host.Pages.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Conduit.Host"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="40,28,40,40" MaxWidth="1040">
            <Grid>
                <TextBlock Text="Agent" Style="{StaticResource PageTitle}" />
                <Button x:Name="RescanButton" Content="重新检测" HorizontalAlignment="Right" Click="Rescan_Click" />
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}"
                       Text="Conduit 通过各 Agent 官方的程序接口驱动它们，沿用你在电脑上已有的登录和配置。会自动在 PATH 和默认安装位置查找；自定义安装位置可点“浏览”指定。" />

            <ItemsControl x:Name="AgentList" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AgentItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" FontSize="18" FontFamily="{StaticResource ConduitSerif}" />
                                        <TextBlock Text="{x:Bind Vendor}" Foreground="{ThemeResource ConduitInkSoftBrush}" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource ConduitInkSoftBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind PathText}" FontSize="12" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <Button Content="浏览…" Tag="{x:Bind Id}" Click="Browse_Click" Visibility="{x:Bind BrowseVisibility}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="安装方法" Style="{StaticResource Eyebrow}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Claude" /><Run Text=" —— 安装 Claude Desktop（内含 Claude Code），或运行：irm https://claude.ai/install.ps1 | iex" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Codex" /><Run Text=" —— 安装 Codex Desktop，或运行：npm i -g @openai/codex" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Pi" /><Run Text=" —— npm i -g @mariozechner/pi-coding-agent" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="opencode" /><Run Text=" —— npm i -g opencode-ai（或 scoop install opencode）" /></TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource ConduitInkSoftBrush}" FontSize="12"
                               Text="在这台电脑上登录过各 Agent 即可；Conduit 直接沿用这些登录，不会读取你的密码。" />
                </StackPanel>
            </Border>

            <ToggleSwitch x:Name="DemoToggle" Margin="0,16,0,0" Header="演示 Agent（无需安装任何东西即可体验）" Toggled="Demo_Toggled" />
        </StackPanel>
    </ScrollViewer>
</Page>
