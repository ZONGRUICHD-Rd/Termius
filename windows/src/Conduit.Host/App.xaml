<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Conduit.Host.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Warm editorial palette: ivory, ink and clay. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#D97757</Color>
                    <Color x:Key="SystemAccentColorLight1">#E08A6D</Color>
                    <Color x:Key="SystemAccentColorLight2">#E8A188</Color>
                    <Color x:Key="SystemAccentColorDark1">#C6613F</Color>
                    <Color x:Key="SystemAccentColorDark2">#A94F31</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#C6613F" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D97757" Opacity="0.9" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D97757" Opacity="0.8" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#A94F31" />
                    <SolidColorBrush x:Key="ConduitPaperBrush" Color="#FAF9F5" Opacity="0.65" />
                    <SolidColorBrush x:Key="ConduitCardBrush" Color="#FFFFFF" Opacity="0.7" />
                    <SolidColorBrush x:Key="ConduitInkSoftBrush" Color="#5E5D59" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#D97757</Color>
                    <Color x:Key="SystemAccentColorLight1">#E08A6D</Color>
                    <Color x:Key="SystemAccentColorLight2">#E8A188</Color>
                    <Color x:Key="SystemAccentColorDark1">#C6613F</Color>
                    <Color x:Key="SystemAccentColorDark2">#A94F31</Color>
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D97757" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D97757" Opacity="0.9" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D97757" Opacity="0.8" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E8A188" />
                    <SolidColorBrush x:Key="ConduitPaperBrush" Color="#1F1E1D" Opacity="0.55" />
                    <SolidColorBrush x:Key="ConduitCardBrush" Color="#262624" Opacity="0.75" />
                    <SolidColorBrush x:Key="ConduitInkSoftBrush" Color="#A6A39A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="ConduitSerif">Georgia</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource ConduitSerif}" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource ConduitInkSoftBrush}" />
                <Setter Property="Margin" Value="0,18,0,8" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ConduitCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
