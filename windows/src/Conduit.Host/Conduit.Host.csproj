<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Conduit.Host</RootNamespace>
    <AssemblyName>ConduitHost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\conduit.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain folder / zip, no MSIX or certificate needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required for unpackaged apps too: generates resources.pri, which holds the compiled XAML (.xbf).
         Without it the app exits silently at startup. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Own Main (Program.cs) so startup failures are logged and shown instead of a silent exit. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Product>Conduit Host</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Conduit.Host.Core\Conduit.Host.Core.csproj" />
  </ItemGroup>

  <!-- Unpackaged publish doesn't always carry the app's PRI (compiled XAML) into PublishDir; copy it explicitly. -->
  <Target Name="ConduitCopyPriToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ConduitPri Include="$(OutDir)*.pri" Exclude="$(OutDir)Microsoft.*.pri" />
      <_ConduitPri Include="$(ProjectPriFullPath)" Condition="'$(ProjectPriFullPath)' != '' And Exists('$(ProjectPriFullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_ConduitPri)' == ''" Text="App PRI (resources.pri) was not generated — the published app would not be able to load its XAML." />
    <Copy SourceFiles="@(_ConduitPri)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)resources.pri')" Text="resources.pri is missing from $(PublishDir)." />
    <Message Importance="high" Text="Conduit PRI copied to publish: @(_ConduitPri)" />
  </Target>

</Project>
